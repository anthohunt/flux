# Reglages de flux pour une machine. Copier en .env (ignore par git), adapter, puis :
#   set -a; . ./.env; set +a
# Toutes les variables sont facultatives : la valeur indiquee est le defaut.

# --- Console web (runtime/server.js) ---
# Adresse d'ecoute. La console n'a PAS d'authentification : ne l'ouvrez au reseau
# (0.0.0.0) que derriere un reseau prive ou un proxy authentifie.
FLUX_HOTE=127.0.0.1
FLUX_PORT=8901
# Proprietaire (utilisateur:groupe) des fichiers que la console ecrit, si elle tourne
# sous un autre compte que les agents. Vide = rien n'est change.
FLUX_PROPRIETAIRE=
# Jauge de quota des comptes Claude (point d'acces non documente d'Anthropic) : 1 = activee.
FLUX_JAUGE_QUOTA=0

# --- Ou vivent les choses ---
# Dossier sous lequel vivent les runs `<workflow>-runs` d'un graphe sans `workspace_root`.
FLUX_RUNS_HOME=$HOME
# Etat des runs (passes, notes, journaux) ; defaut : <depot>/state
# FLUX_STATE_DIR=/chemin/vers/state
# Skills injectes aux agents du moteur tmux (un sous-dossier par skill, avec SKILL.md).
# FLUX_SKILLS_DIR=/chemin/vers/skills
# Outils de pipeline facultatifs (rapport de run, rendu des transcripts...) ;
# defaut : <FLUX_SKILLS_DIR>/pipeline-runtime
# FLUX_PIPELINE_RUNTIME=/chemin/vers/pipeline-runtime
# Dossiers de validateurs en plus de validators/, separes par « : »
# FLUX_VALIDATORS_PATH=/chemin/vers/ma-pipeline/validators

# --- Claude Code ---
# Fichier des moteurs (comptes Claude) ; defaut : moteurs.json, sinon moteurs.example.json
# FLUX_MOTEURS=/chemin/vers/moteurs.json
FLUX_CLAUDE_BIN=claude
# Dossier de config Claude Code quand aucun moteur n'en declare (voir moteurs.example.json)
# CLAUDE_CONFIG_DIR=$HOME/.claude
# 1 = accepter une version de Claude Code differente de celle epinglee
FLUX_IGNORER_VERSION=0

# --- Modeles locaux (moteur api) ---
# FLUX_OLLAMA_URL=http://127.0.0.1:11434
# FLUX_LLAMACPP_URL=http://127.0.0.1:8080

# --- Alertes (run bloquee) ---
# Une adresse HTTP appelee avec les parametres de l'alerte dans la query string
# FLUX_NOTIF_URL=https://ntfy.example.org/flux
# Une commande appelee avec --sujet et --corps si l'adresse ne repond pas
# FLUX_ALERTE_CMD=/usr/local/bin/mon-alerte

# --- Etape interactive jouee sur un autre poste (runtime/flux-local) ---
# FLUX_VPS=agents@flux.example.org
# FLUX_API=http://flux.example.org:8901
# FLUX_DISTANT=/srv/flux
# FLUX_LOCAL_ROOT=$HOME/flux-runs

# --- Lot de mesure tenu hors du depot (facultatif) ---
# FLUX_MESURE=/var/lib/flux-mesure
